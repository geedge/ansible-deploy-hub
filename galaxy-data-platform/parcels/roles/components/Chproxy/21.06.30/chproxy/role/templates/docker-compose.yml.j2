version: '3'

services:
  chproxy:
    image: {{ image_name }}:{{ image_tag }}
    container_name: {{ container_name }}
    ports:
      - "8124:8124"
    volumes:
      - "{{ deploy_dir }}/{{ container_name }}/config:/home/config"
      - "{{ deploy_dir }}/{{ container_name }}/log:/home/log"
    restart: always
    networks:
      olap:
        ipv4_address: 172.20.88.9
networks:
  olap:
    external: true
