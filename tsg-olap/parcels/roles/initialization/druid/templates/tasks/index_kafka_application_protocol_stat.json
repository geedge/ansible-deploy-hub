                    ]
                },
                "flattenSpec": {
                    "useFieldDiscovery": true,
                    "fields": [
                        {"name": "vsys_id", "type": "path", "expr": "$.tags.vsys_id"},
                        {"name": "data_center", "type": "path", "expr": "$.tags.data_center"},
                        {"name": "device_group", "type": "path", "expr": "$.tags.device_group"},
