version: '3'

services:
   redis:
    image: {{ image_name }}:{{ image_tag }}
    restart: always
    container_name: {{ container_name }}
    volumes:
      - {{ deploy_dir }}/{{ container_name }}/conf/redis.conf:/redis.conf
      - {{ deploy_dir }}/{{ container_name }}/data:/data
    command: redis-server /redis.conf
    network_mode: "host"
